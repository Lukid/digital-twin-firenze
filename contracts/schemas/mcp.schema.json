{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://dt-pisa.example/contracts/schemas/mcp.schema.json",
 "title": "Strumenti MCP: input e output",
 "description": "Un def per direzione: <tool>.input e <tool>.output. Nessun input accetta codice o SQL libero (additionalProperties false ovunque). Ogni output è il risultato oppure tool_error.",
 "$defs": {
  "list_approved_sources.input": {
   "type": "object",
   "required": [
    "theme",
    "aoi_id"
   ],
   "additionalProperties": false,
   "properties": {
    "theme": {
     "enum": [
      "edifici",
      "quote",
      "rete_pedonale",
      "verde",
      "destinazioni",
      "trasporto",
      "licenze"
     ]
    },
    "aoi_id": {
     "$ref": "common.schema.json#/$defs/id_aoi"
    }
   }
  },
  "list_approved_sources.output": {
   "oneOf": [
    {
     "type": "object",
     "required": [
      "sources",
      "gaps"
     ],
     "additionalProperties": false,
     "properties": {
      "sources": {
       "type": "array",
       "items": {
        "type": "object",
        "required": [
         "source_id",
         "snapshot_id",
         "license_state",
         "permitted_use",
         "content_period"
        ],
        "additionalProperties": false,
        "properties": {
         "source_id": {
          "$ref": "common.schema.json#/$defs/id_source"
         },
         "snapshot_id": {
          "$ref": "common.schema.json#/$defs/id_snapshot"
         },
         "license_state": {
          "$ref": "common.schema.json#/$defs/license_state"
         },
         "permitted_use": {
          "enum": [
           "redistribution",
           "internal_prototype",
           "none"
          ]
         },
         "content_period": {
          "$ref": "common.schema.json#/$defs/content_period"
         }
        }
       }
      },
      "gaps": {
       "type": "array",
       "items": {
        "type": "object",
        "required": [
         "theme",
         "text"
        ],
        "additionalProperties": false,
        "properties": {
         "theme": {
          "enum": [
           "edifici",
           "quote",
           "rete_pedonale",
           "verde",
           "destinazioni",
           "trasporto",
           "licenze"
          ]
         },
         "text": {
          "type": "string",
          "minLength": 5
         }
        }
       }
      }
     }
    },
    {
     "$ref": "common.schema.json#/$defs/tool_error"
    }
   ]
  },
  "inspect_dataset.input": {
   "oneOf": [
    {
     "type": "object",
     "required": [
      "source_id"
     ],
     "additionalProperties": false,
     "properties": {
      "source_id": {
       "$ref": "common.schema.json#/$defs/id_source"
      }
     }
    },
    {
     "type": "object",
     "required": [
      "snapshot_id"
     ],
     "additionalProperties": false,
     "properties": {
      "snapshot_id": {
       "$ref": "common.schema.json#/$defs/id_snapshot"
      }
     }
    }
   ]
  },
  "inspect_dataset.output": {
   "oneOf": [
    {
     "type": "object",
     "required": [
      "source_id",
      "snapshot_id",
      "fields",
      "extent",
      "content_period",
      "license"
     ],
     "additionalProperties": false,
     "properties": {
      "source_id": {
       "$ref": "common.schema.json#/$defs/id_source"
      },
      "snapshot_id": {
       "$ref": "common.schema.json#/$defs/id_snapshot"
      },
      "fields": {
       "type": "array",
       "items": {
        "type": "object",
        "required": [
         "name",
         "unit",
         "classification"
        ],
        "additionalProperties": false,
        "properties": {
         "name": {
          "type": "string"
         },
         "unit": {
          "type": "string"
         },
         "classification": {
          "$ref": "common.schema.json#/$defs/classification"
         },
         "populated_fraction": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
         }
        }
       }
      },
      "extent": {
       "$ref": "common.schema.json#/$defs/bbox_en"
      },
      "content_period": {
       "$ref": "common.schema.json#/$defs/content_period"
      },
      "license": {
       "$ref": "common.schema.json#/$defs/license"
      },
      "quality": {
       "type": "array",
       "items": {
        "type": "string"
       }
      }
     }
    },
    {
     "$ref": "common.schema.json#/$defs/tool_error"
    }
   ]
  },
  "list_destinations.input": {
   "type": "object",
   "required": [
    "aoi_id",
    "category"
   ],
   "additionalProperties": false,
   "properties": {
    "aoi_id": {
     "$ref": "common.schema.json#/$defs/id_aoi"
    },
    "category": {
     "enum": [
      "school",
      "university",
      "stop",
      "station",
      "hospital",
      "cooling_refuge"
     ]
    },
    "name_query": {
     "type": "string",
     "maxLength": 80
    }
   }
  },
  "list_destinations.output": {
   "oneOf": [
    {
     "type": "object",
     "required": [
      "destinations"
     ],
     "additionalProperties": false,
     "properties": {
      "destinations": {
       "type": "array",
       "items": {
        "type": "object",
        "required": [
         "destination_id",
         "category",
         "name",
         "verification",
         "entrances"
        ],
        "additionalProperties": false,
        "properties": {
         "destination_id": {
          "$ref": "common.schema.json#/$defs/id_destination"
         },
         "category": {
          "enum": [
           "school",
           "university",
           "stop",
           "station",
           "hospital",
           "cooling_refuge"
          ]
         },
         "name": {
          "type": "string"
         },
         "verification": {
          "$ref": "common.schema.json#/$defs/verification_state"
         },
         "access_conditions": {
          "type": "string"
         },
         "entrances": {
          "type": "array",
          "items": {
           "type": "object",
           "required": [
            "entrance_id",
            "position",
            "verification"
           ],
           "additionalProperties": false,
           "properties": {
            "entrance_id": {
             "$ref": "common.schema.json#/$defs/id_entrance"
            },
            "position": {
             "$ref": "common.schema.json#/$defs/position"
            },
            "verification": {
             "$ref": "common.schema.json#/$defs/verification_state"
            }
           }
          }
         }
        }
       }
      }
     }
    },
    {
     "$ref": "common.schema.json#/$defs/tool_error"
    }
   ]
  },
  "list_scenarios.input": {
   "type": "object",
   "additionalProperties": false,
   "description": "Scenari salvati dell'area: quelli versionati del progetto e quelli creati con create_local_scenario.",
   "properties": {
    "baseline_id": {
     "$ref": "common.schema.json#/$defs/id_baseline"
    }
   }
  },
  "list_scenarios.output": {
   "oneOf": [
    {
     "type": "object",
     "required": [
      "scenarios"
     ],
     "additionalProperties": false,
     "properties": {
      "scenarios": {
       "type": "array",
       "items": {
        "type": "object",
        "required": [
         "scenario_id",
         "title",
         "version",
         "baseline_id",
         "interventions"
        ],
        "additionalProperties": false,
        "properties": {
         "scenario_id": {
          "$ref": "common.schema.json#/$defs/id_scenario"
         },
         "title": {
          "type": "string"
         },
         "version": {
          "type": "integer",
          "minimum": 1
         },
         "baseline_id": {
          "$ref": "common.schema.json#/$defs/id_baseline"
         },
         "interventions": {
          "type": "object",
          "description": "Conteggi e aree: alberi, pensiline, area di proiezione delle chiome e delle pensiline in m2."
         }
        }
       }
      }
     }
    },
    {
     "$ref": "common.schema.json#/$defs/tool_error"
    }
   ]
  },
  "compute_walk_access.input": {
   "type": "object",
   "required": [
    "baseline_id",
    "origins",
    "destination_ids",
    "profile",
    "thresholds_min"
   ],
   "additionalProperties": false,
   "properties": {
    "baseline_id": {
     "$ref": "common.schema.json#/$defs/id_baseline"
    },
    "origins": {
     "oneOf": [
      {
       "type": "object",
       "required": [
        "kind",
        "points"
       ],
       "additionalProperties": false,
       "properties": {
        "kind": {
         "const": "points"
        },
        "points": {
         "type": "array",
         "minItems": 1,
         "maxItems": 20000,
         "items": {
          "$ref": "common.schema.json#/$defs/position"
         }
        }
       }
      },
      {
       "type": "object",
       "required": [
        "kind",
        "aoi_id",
        "spacing_m"
       ],
       "additionalProperties": false,
       "properties": {
        "kind": {
         "const": "grid"
        },
        "aoi_id": {
         "$ref": "common.schema.json#/$defs/id_aoi"
        },
        "spacing_m": {
         "type": "number",
         "minimum": 5,
         "maximum": 200
        }
       }
      },
      {
       "type": "object",
       "required": [
        "kind",
        "aoi_id"
       ],
       "additionalProperties": false,
       "description": "Civici dell'area indicata (punti d'indirizzo, non residenti). Fonte e licenza dei civici sono quelle della baseline dell'area.",
       "properties": {
        "kind": {
         "const": "address_points"
        },
        "aoi_id": {
         "$ref": "common.schema.json#/$defs/id_aoi"
        }
       }
      },
      {
       "type": "object",
       "required": [
        "kind"
       ],
       "additionalProperties": false,
       "description": "Civici SIT di Pisa Z2, forma storica di address_points con aoi_z2: resta valida perché i job già calcolati ne hanno l'hash (punti d'indirizzo, non residenti; licenza non dimostrata, solo uso interno).",
       "properties": {
        "kind": {
         "const": "civici_sit_z2"
        }
       }
      }
     ]
    },
    "destination_ids": {
     "type": "array",
     "minItems": 1,
     "maxItems": 20,
     "items": {
      "$ref": "common.schema.json#/$defs/id_destination"
     },
     "description": "Una destinazione, oppure più destinazioni: in quel caso il risultato è l'accessibilità verso almeno una (per ogni civico conta la più vicina)."
    },
    "profile": {
     "type": "object",
     "required": [
      "speed_m_s"
     ],
     "additionalProperties": false,
     "properties": {
      "speed_m_s": {
       "type": "number",
       "description": "Velocità ipotizzata. Riferimento del progetto 1,2 m/s (i job della mappa usano 1,2, 0,8 e 1,4); dichiararla se l'utente non la dà.",
       "minimum": 0.3,
       "maximum": 2.5
      },
      "snap_limit_m": {
       "type": "number",
       "minimum": 1,
       "maximum": 100
      },
      "crossing_penalty_s": {
       "type": "number",
       "minimum": 0,
       "maximum": 120,
       "description": "Attesa in secondi per ogni attraversamento (ipotesi, default 0)."
      },
      "stairs": {
       "enum": [
        "allowed",
        "excluded"
       ],
       "description": "Scale ammesse o escluse (default allowed)."
      }
     }
    },
    "thresholds_min": {
     "type": "array",
     "minItems": 1,
     "maxItems": 6,
     "uniqueItems": true,
     "description": "Soglie in minuti, senza ripetizioni. I job della mappa usano [5, 10, 15]: con le stesse soglie il risultato viene dalla cache ed è lo stesso job della mappa.",
     "items": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 60
     }
    },
    "entrance_ids": {
     "type": "array",
     "minItems": 1,
     "maxItems": 5,
     "uniqueItems": true,
     "items": {
      "$ref": "common.schema.json#/$defs/id_entrance"
     },
     "description": "Ingressi da considerare per la destinazione (vince il più vicino per tempo). Assente: ingresso predefinito, dichiarato nel manifest."
    }
   }
  },
  "compute_walk_access.output": {
   "oneOf": [
    {
     "type": "object",
     "required": [
      "job_id",
      "status"
     ],
     "additionalProperties": false,
     "properties": {
      "job_id": {
       "$ref": "common.schema.json#/$defs/id_job"
      },
      "status": {
       "enum": [
        "queued",
        "running",
        "succeeded",
        "failed",
        "rejected_limits"
       ]
      },
      "result_manifest_id": {
       "$ref": "common.schema.json#/$defs/id_manifest"
      },
      "headline_metrics": {
       "type": "array",
       "items": {
        "$ref": "common.schema.json#/$defs/metric"
       }
      },
      "progress": {
       "type": "number",
       "minimum": 0,
       "maximum": 1
      },
      "cached": {
       "type": "boolean",
       "description": "true se il risultato viene dalla cache (stesso job_id già eseguito)."
      },
      "datasets": {
       "type": "array",
       "description": "Snapshot usati, con checksum e licenza.",
       "items": {
        "type": "object",
        "required": [
         "snapshot_id",
         "source_id",
         "sha256",
         "license_state"
        ],
        "additionalProperties": false,
        "properties": {
         "snapshot_id": {
          "$ref": "common.schema.json#/$defs/id_snapshot"
         },
         "source_id": {
          "$ref": "common.schema.json#/$defs/id_source"
         },
         "sha256": {
          "$ref": "common.schema.json#/$defs/sha256"
         },
         "license_state": {
          "$ref": "common.schema.json#/$defs/license_state"
         }
        }
       }
      },
      "params": {
       "type": "object",
       "description": "Parametri risolti del job (default compresi): quelli che entrano nell'hash."
      },
      "limits": {
       "type": "array",
       "description": "Limiti del risultato (stessi del manifest).",
       "items": {
        "$ref": "common.schema.json#/$defs/limit"
       }
      },
      "method": {
       "type": "string",
       "description": "Nome e versione del metodo."
      }
     },
     "allOf": [
      {
       "if": {
        "properties": {
         "status": {
          "const": "succeeded"
         }
        },
        "required": [
         "status"
        ]
       },
       "then": {
        "required": [
         "result_manifest_id"
        ]
       }
      }
     ]
    },
    {
     "$ref": "common.schema.json#/$defs/tool_error"
    }
   ]
  },
  "compute_shadow.input": {
   "type": "object",
   "required": [
    "baseline_id",
    "receivers",
    "when",
    "method"
   ],
   "additionalProperties": false,
   "properties": {
    "baseline_id": {
     "$ref": "common.schema.json#/$defs/id_baseline"
    },
    "scenario_id": {
     "$ref": "common.schema.json#/$defs/id_scenario"
    },
    "receivers": {
     "type": "array",
     "minItems": 1,
     "maxItems": 50,
     "items": {
      "oneOf": [
       {
        "type": "object",
        "required": [
         "receiver_id",
         "kind",
         "geometry"
        ],
        "additionalProperties": false,
        "properties": {
         "receiver_id": {
          "$ref": "common.schema.json#/$defs/id_feature"
         },
         "kind": {
          "enum": [
           "path",
           "surface"
          ]
         },
         "geometry": {
          "$ref": "common.schema.json#/$defs/geometry"
         }
        }
       },
       {
        "type": "object",
        "required": [
         "route_id"
        ],
        "additionalProperties": false,
        "description": "Percorso campione per ID (network/percorsi_campione.geojson, es. R01, o RC1-RC5 verso i rifugi climatici), espanso dal servizio nella sua geometria sull'asse della rete.",
        "properties": {
         "route_id": {
          "type": "string",
          "pattern": "^R(C[0-9]|[0-9]{2})$"
         }
        }
       }
      ]
     }
    },
    "when": {
     "type": "object",
     "required": [
      "date",
      "timezone",
      "times"
     ],
     "additionalProperties": false,
     "properties": {
      "date": {
       "$ref": "common.schema.json#/$defs/date"
      },
      "timezone": {
       "const": "Europe/Rome"
      },
      "times": {
       "type": "array",
       "minItems": 1,
       "maxItems": 96,
       "items": {
        "$ref": "common.schema.json#/$defs/local_time"
       }
      }
     }
    },
    "method": {
     "type": "object",
     "required": [
      "name",
      "space_step_m",
      "time_step_min",
      "obstacles"
     ],
     "additionalProperties": false,
     "properties": {
      "name": {
       "const": "geometric_ray"
      },
      "space_step_m": {
       "type": "number",
       "description": "Passo dei punti sul ricevitore. I job della mappa usano 1 m (e time_step_min 5).",
       "minimum": 0.25,
       "maximum": 5
      },
      "time_step_min": {
       "type": "number",
       "minimum": 1,
       "maximum": 30
      },
      "obstacles": {
       "enum": [
        "documented_buildings_only",
        "buildings_and_scenario",
        "buildings_and_trees",
        "buildings_trees_and_lidar_vegetation"
       ],
       "description": "buildings_and_trees: edifici documentati più chiome idealizzate in tre casi (minimo, tipico, massimo), stimate per classe. buildings_trees_and_lidar_vegetation: in più la vegetazione rilevata dal LiDAR senza albero censito (prismi opachi, tre casi)."
      }
     }
    },
    "walk_speed_m_s": {
     "type": "number",
     "minimum": 0.3,
     "maximum": 2.5
    }
   }
  },
  "compute_shadow.output": {
   "oneOf": [
    {
     "type": "object",
     "required": [
      "job_id",
      "status"
     ],
     "additionalProperties": false,
     "properties": {
      "job_id": {
       "$ref": "common.schema.json#/$defs/id_job"
      },
      "status": {
       "enum": [
        "queued",
        "running",
        "succeeded",
        "failed",
        "rejected_limits"
       ]
      },
      "result_manifest_id": {
       "$ref": "common.schema.json#/$defs/id_manifest"
      },
      "headline_metrics": {
       "type": "array",
       "items": {
        "$ref": "common.schema.json#/$defs/metric"
       }
      },
      "progress": {
       "type": "number",
       "minimum": 0,
       "maximum": 1
      },
      "cached": {
       "type": "boolean",
       "description": "true se il risultato viene dalla cache (stesso job_id già eseguito)."
      },
      "datasets": {
       "type": "array",
       "description": "Snapshot usati, con checksum e licenza.",
       "items": {
        "type": "object",
        "required": [
         "snapshot_id",
         "source_id",
         "sha256",
         "license_state"
        ],
        "additionalProperties": false,
        "properties": {
         "snapshot_id": {
          "$ref": "common.schema.json#/$defs/id_snapshot"
         },
         "source_id": {
          "$ref": "common.schema.json#/$defs/id_source"
         },
         "sha256": {
          "$ref": "common.schema.json#/$defs/sha256"
         },
         "license_state": {
          "$ref": "common.schema.json#/$defs/license_state"
         }
        }
       }
      },
      "params": {
       "type": "object",
       "description": "Parametri risolti del job (default compresi): quelli che entrano nell'hash."
      },
      "limits": {
       "type": "array",
       "description": "Limiti del risultato (stessi del manifest).",
       "items": {
        "$ref": "common.schema.json#/$defs/limit"
       }
      },
      "method": {
       "type": "string",
       "description": "Nome e versione del metodo."
      },
      "cases": {
       "type": "array",
       "description": "Casi calcolati: base e sensibilità altezze, più alberi min/tipico/max se gli ostacoli includono le chiome.",
       "items": {
        "enum": [
         "base",
         "base_h_min",
         "base_h_max",
         "alberi_min",
         "alberi_tipico",
         "alberi_max",
         "alberi_tipico_cilindro",
         "veg_lidar_min",
         "veg_lidar_tipico",
         "veg_lidar_max"
        ]
       }
      },
      "sun_state_counts": {
       "type": "object",
       "description": "Conteggio delle righe (ricevitore, ora, caso) per stato del sole: ok, sole sotto l'orizzonte, sole basso fuori dal supporto del modello (sotto 5 gradi). Gli ultimi due non hanno risultato numerico.",
       "propertyNames": {
        "enum": [
         "ok",
         "sole_sotto_orizzonte",
         "sole_basso_fuori_supporto"
        ]
       },
       "additionalProperties": {
        "type": "integer",
        "minimum": 0
       }
      },
      "summary": {
       "type": "array",
       "description": "Medie per ricevitore, caso e fascia oraria (solo istanti con sole supportato).",
       "items": {
        "type": "object",
        "required": [
         "receiver_id",
         "caso",
         "fascia",
         "n_orari",
         "n_orari_calcolati",
         "stati"
        ],
        "properties": {
         "receiver_id": {
          "$ref": "common.schema.json#/$defs/id_feature"
         },
         "caso": {
          "type": "string"
         },
         "fascia": {
          "type": "string"
         },
         "n_orari": {
          "type": "integer"
         },
         "n_orari_calcolati": {
          "type": "integer"
         },
         "stati": {
          "type": "array",
          "items": {
           "enum": [
            "ok",
            "sole_sotto_orizzonte",
            "sole_basso_fuori_supporto"
           ]
          }
         }
        }
       }
      },
      "scenario_id": {
       "$ref": "common.schema.json#/$defs/id_scenario"
      },
      "scenario_version": {
       "type": "integer",
       "minimum": 1
      }
     },
     "allOf": [
      {
       "if": {
        "properties": {
         "status": {
          "const": "succeeded"
         }
        },
        "required": [
         "status"
        ]
       },
       "then": {
        "required": [
         "result_manifest_id"
        ]
       }
      }
     ]
    },
    {
     "$ref": "common.schema.json#/$defs/tool_error"
    }
   ]
  },
  "create_local_scenario.input": {
   "type": "object",
   "required": [
    "baseline_id",
    "scenario_title",
    "operations"
   ],
   "additionalProperties": false,
   "properties": {
    "baseline_id": {
     "$ref": "common.schema.json#/$defs/id_baseline"
    },
    "scenario_title": {
     "type": "string",
     "minLength": 3,
     "maxLength": 120
    },
    "operations": {
     "type": "array",
     "maxItems": 200,
     "items": {
      "$ref": "scenario.schema.json#/$defs/operation"
     }
    }
   }
  },
  "create_local_scenario.output": {
   "oneOf": [
    {
     "type": "object",
     "required": [
      "scenario_id",
      "version"
     ],
     "additionalProperties": false,
     "properties": {
      "scenario_id": {
       "$ref": "common.schema.json#/$defs/id_scenario"
      },
      "version": {
       "type": "integer",
       "minimum": 1
      },
      "cached": {
       "type": "boolean",
       "description": "true se lo scenario con lo stesso contenuto esisteva già (stesso scenario_id)."
      },
      "warnings": {
       "type": "array",
       "description": "Segnalazioni di validazione (interventi dentro edifici, su carreggiata senza marciapiede, su un arco molto usato, fuori dall'area). Non bloccano la creazione.",
       "items": {
        "type": "object",
        "required": [
         "code",
         "op_id",
         "severity",
         "text"
        ],
        "additionalProperties": false,
        "properties": {
         "code": {
          "type": "string"
         },
         "op_id": {
          "type": "string"
         },
         "severity": {
          "enum": [
           "info",
           "warning"
          ]
         },
         "text": {
          "type": "string"
         }
        }
       }
      },
      "feasibility": {
       "type": "object",
       "description": "Fattibilità sempre ignota: sottoservizi, spazio radicale, permessi, proprietà del suolo, manutenzione e specie.",
       "additionalProperties": {
        "const": "ignota"
       }
      },
      "interventions": {
       "type": "object",
       "description": "Numero e superficie degli interventi.",
       "additionalProperties": {
        "type": "number"
       }
      }
     }
    },
    {
     "$ref": "common.schema.json#/$defs/tool_error"
    }
   ]
  },
  "compare_scenarios.input": {
   "oneOf": [
    {
     "type": "object",
     "required": [
      "manifest_ids",
      "metric_ids"
     ],
     "additionalProperties": false,
     "properties": {
      "manifest_ids": {
       "type": "array",
       "minItems": 2,
       "maxItems": 10,
       "uniqueItems": true,
       "items": {
        "$ref": "common.schema.json#/$defs/id_manifest"
       }
      },
      "metric_ids": {
       "type": "array",
       "minItems": 1,
       "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]{1,60}$"
       }
      }
     }
    },
    {
     "type": "object",
     "required": [
      "baseline_id",
      "scenario_ids"
     ],
     "additionalProperties": false,
     "description": "Confronto multicriterio di scenari con la baseline (S0) su condizioni comuni: delta su R01 e percorsi campione, area di attesa, tratti più usati pesati per civici, accessibilità. I pesi sono un parametro facoltativo del decisore: senza pesi nessun ordinamento.",
     "properties": {
      "baseline_id": {
       "$ref": "common.schema.json#/$defs/id_baseline"
      },
      "scenario_ids": {
       "type": "array",
       "minItems": 1,
       "maxItems": 5,
       "uniqueItems": true,
       "items": {
        "$ref": "common.schema.json#/$defs/id_scenario"
       }
      },
      "with_variants": {
       "type": "boolean",
       "description": "Includere le varianti di sensibilità degli scenari dimostrativi (default true)."
      },
      "weights": {
       "type": "object",
       "description": "Pesi del decisore per un ordinamento esplicito (>= 0, somma positiva).",
       "additionalProperties": false,
       "minProperties": 1,
       "properties": {
        "r01_minuti_sole_evitati_mezzogiorno": {
         "type": "number",
         "minimum": 0
        },
        "r01_minuti_sole_evitati_giornata": {
         "type": "number",
         "minimum": 0
        },
        "campione_minuti_sole_evitati_mezzogiorno": {
         "type": "number",
         "minimum": 0
        },
        "archi_civici_minuti_evitati_mezzogiorno": {
         "type": "number",
         "minimum": 0
        },
        "area_attesa_ombra_mezzogiorno": {
         "type": "number",
         "minimum": 0
        }
       }
      },
      "context": {
       "enum": [
        "solo_edifici",
        "con_alberi_esistenti",
        "entrambi",
        "con_vegetazione_lidar"
       ],
       "description": "Contesto delle ombre. Per Firenze: con_vegetazione_lidar (default, base di confronto principale: edifici, alberi censiti e vegetazione LiDAR), solo_edifici, con_alberi_esistenti (edifici e alberi censiti a chioma tipica, min e max come intervallo) o entrambi (tutti e tre i contesti). Nei metric_id il contesto è il suffisso _edifici, _alb o _lidar."
      }
     }
    }
   ]
  },
  "compare_scenarios.output": {
   "oneOf": [
    {
     "type": "object",
     "required": [
      "common_conditions",
      "deltas",
      "incompatibilities"
     ],
     "additionalProperties": false,
     "properties": {
      "common_conditions": {
       "type": "object"
      },
      "deltas": {
       "type": "array",
       "items": {
        "type": "object",
        "required": [
         "metric_id",
         "baseline_value",
         "scenario_value",
         "delta",
         "unit",
         "classification",
         "discriminates"
        ],
        "additionalProperties": false,
        "properties": {
         "metric_id": {
          "type": "string"
         },
         "baseline_value": {
          "type": "number"
         },
         "scenario_value": {
          "type": "number"
         },
         "delta": {
          "type": "number"
         },
         "unit": {
          "$ref": "common.schema.json#/$defs/unit"
         },
         "classification": {
          "$ref": "common.schema.json#/$defs/classification"
         },
         "discriminates": {
          "type": "boolean",
          "description": "false se il delta è dentro l'incertezza"
         },
         "delta_low": {
          "type": "number",
          "description": "Estremo inferiore dell'intervallo del delta (altezze degli edifici, lato del marciapiede)."
         },
         "delta_high": {
          "type": "number"
         },
         "scope": {
          "type": "string"
         }
        }
       }
      },
      "incompatibilities": {
       "type": "array",
       "items": {
        "$ref": "common.schema.json#/$defs/limit"
       }
      },
      "job_id": {
       "$ref": "common.schema.json#/$defs/id_job"
      },
      "result_manifest_id": {
       "$ref": "common.schema.json#/$defs/id_manifest"
      },
      "cached": {
       "type": "boolean"
      },
      "status": {
       "enum": [
        "succeeded"
       ]
      },
      "datasets": {
       "type": "array",
       "items": {
        "type": "object",
        "required": [
         "snapshot_id",
         "source_id",
         "sha256",
         "license_state"
        ],
        "additionalProperties": false,
        "properties": {
         "snapshot_id": {
          "$ref": "common.schema.json#/$defs/id_snapshot"
         },
         "source_id": {
          "$ref": "common.schema.json#/$defs/id_source"
         },
         "sha256": {
          "$ref": "common.schema.json#/$defs/sha256"
         },
         "license_state": {
          "$ref": "common.schema.json#/$defs/license_state"
         }
        }
       }
      },
      "params": {
       "type": "object"
      },
      "limits": {
       "type": "array",
       "items": {
        "$ref": "common.schema.json#/$defs/limit"
       }
      },
      "method": {
       "type": "string"
      },
      "scenarios": {
       "type": "object",
       "description": "Per scenario: indicatori separati, segnalazioni, fattibilità ignota, accessibilità, robustezza alle varianti (riepilogo completo del confronto)."
      },
      "indicators": {
       "type": "object",
       "description": "Indicatori scalari per scenario (positivi se c'è un beneficio): nessun punteggio unico."
      },
      "ranking": {
       "type": "object",
       "description": "Presente solo se il decisore ha dato i pesi; riporta pesi, punteggi e ordine con l'avvertenza che dipendono dai pesi."
      },
      "indicators_con_alberi_esistenti": {
       "type": "object",
       "description": "Indicatori scalari nel contesto con alberi esistenti (presente se il contesto lo richiede)."
      }
     }
    },
    {
     "$ref": "common.schema.json#/$defs/tool_error"
    }
   ]
  },
  "get_job_status.input": {
   "type": "object",
   "required": [
    "job_id"
   ],
   "additionalProperties": false,
