{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dt-pisa.example/contracts/schemas/job.schema.json",
  "title": "Job di analisi",
  "description": "job_id = 'job_' + primi 16 esadecimali dello sha256 del JSON canonico (tool, inputs, params): stesso input, stesso job, quindi cache e replay.",
  "type": "object",
  "required": ["job_id", "tool", "status", "created_at", "inputs", "params", "limits"],
  "additionalProperties": false,
  "properties": {
    "job_id": {"$ref": "common.schema.json#/$defs/id_job"},
    "tool": {"enum": ["compute_walk_access", "compute_shadow", "compare_scenarios"]},
    "status": {"enum": ["queued", "running", "succeeded", "failed", "rejected_limits", "cancelled"]},
    "created_at": {"$ref": "common.schema.json#/$defs/timestamp"},
    "started_at": {"$ref": "common.schema.json#/$defs/timestamp"},
    "finished_at": {"$ref": "common.schema.json#/$defs/timestamp"},
    "inputs": {
      "type": "object",
      "required": ["baseline_id", "snapshot_ids"],
      "additionalProperties": false,
      "properties": {
        "baseline_id": {"$ref": "common.schema.json#/$defs/id_baseline"},
        "snapshot_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "common.schema.json#/$defs/id_snapshot"}},
        "scenario_id": {"$ref": "common.schema.json#/$defs/id_scenario"},
        "scenario_version": {"type": "integer", "minimum": 1}
      }
    },
    "params": {"type": "object", "description": "Parametri validati dal tool, copiati nel manifest"},
    "limits": {
      "type": "object",
      "required": ["max_area_km2", "max_rows", "max_seconds", "max_memory_mb"],
      "additionalProperties": false,
      "properties": {
        "max_area_km2": {"type": "number", "exclusiveMinimum": 0},
        "max_rows": {"type": "integer", "minimum": 1},
        "max_seconds": {"type": "integer", "minimum": 1},
        "max_memory_mb": {"type": "integer", "minimum": 1}
      }
    },
    "progress": {
      "type": "object",
      "required": ["fraction"],
      "additionalProperties": false,
      "properties": {"fraction": {"type": "number", "minimum": 0, "maximum": 1}, "message": {"type": "string"}}
    },
    "result_manifest_id": {"$ref": "common.schema.json#/$defs/id_manifest"},
    "error": {"$ref": "common.schema.json#/$defs/tool_error/properties/error"}
  },
  "allOf": [
    {"if": {"properties": {"status": {"const": "succeeded"}}, "required": ["status"]}, "then": {"required": ["result_manifest_id", "started_at", "finished_at"]}},
    {"if": {"properties": {"status": {"enum": ["failed", "rejected_limits"]}}, "required": ["status"]}, "then": {"required": ["error"]}},
    {"if": {"properties": {"status": {"enum": ["failed", "rejected_limits", "cancelled", "queued", "running"]}}, "required": ["status"]}, "then": {"not": {"required": ["result_manifest_id"]}}}
  ]
}
