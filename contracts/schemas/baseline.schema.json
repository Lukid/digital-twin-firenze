{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dt-pisa.example/contracts/schemas/baseline.schema.json",
  "title": "Baseline di un'area",
  "description": "Insieme congelato di snapshot su cui girano motori e scenari, legato a una sola area. Il nucleo è comune a tutte le aree; le parti dei motori (grafo, geometrie, ricevitori, condizioni) restano libere.",
  "type": "object",
  "required": ["baseline_id", "version", "frozen_at", "aoi_id", "snapshot"],
  "additionalProperties": true,
  "properties": {
    "baseline_id": {"$ref": "common.schema.json#/$defs/id_baseline"},
    "version": {"type": "integer", "minimum": 1},
    "frozen_at": {"$ref": "common.schema.json#/$defs/timestamp"},
    "aoi_id": {"$ref": "common.schema.json#/$defs/id_aoi"},
    "snapshot": {"type": "array", "minItems": 1, "items": {"$ref": "common.schema.json#/$defs/dataset_ref"}}
  }
}
