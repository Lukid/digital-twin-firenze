active", "uri": "https://opendata.comune.bologna.it/api/v2/catalog/datasets/verde_privato_urbanizzato-xls", "url": "https://opendata.comune.bologna.it/api/v2/catalog/datasets/verde_privato_urbanizzato/exports/xls?use_labels=true", "url_type": null}], "tags": [{"display_name": "N_A", "id": "ea9293e4-ed1f-457a-96fd-daaea846bbe7", "name": "N_A", "state": "active", "vocabulary_id": null}], "relationships_as_subject": [], "relationships_as_object": [], "dataset_is_local": false, "holder_name": "Comune di Bologna", "holder_identifier": "c_a944", "issued": "2026-09-06T22:01:16.720000+00:00"}, {"author": null, "author_email": null, "creator_user_id": "e514c9c4-6d64-45d6-ae28-c70bd3592d59", "id": "563bebe7-0a59-4813-8508-fc18d4933c08", "isopen": false, "license_id": "Creative Commons Attribuzione 4.0 Internazionale (CC BY 4.0)", "license_title": "Creative Commons Attribuzione 4.0 Internazionale (CC BY 4.0)", "maintainer": null, "maintainer_email": null, "metadata_created": "2025-02-13T09:50:08.003167", "metadata_modified": "2026-09-29T15:21:31.459233", "name": "carte-forestali-cmbo-carta-forestale-2003-e-successivi-aggiornamenti-estensione-provincia-di-bo", "notes": "Carta realizzata dalla Provincia di Bologna attraverso la fotointerpretazione del Volo Italia 2000. Tale cartografia e' stata aggiornata fino all'anno 2014 attraverso le istanze di revisione inoltrate dagli Enti territorialmente competenti in materia forestale ed approvate dall'Organo esecutivo della Provincia di Bologna. La Carta forestale individua le aree forestali presenti sul territorio della Provincia di Bologna.  Le aree individuate dalla carta sono: 1 - le superfici forestali cosi' come definite dalle Prescrizioni di Massima e di Polizia Forestale della Regione Emilia-Romagna 2- l\u2019arboricoltura specializzata da legno, i pioppeti e i castagneti da frutto. La Carta descrive secondo il Codice CORINE le comunit\u00e0 forestali presenti sul territorio provinciale e le organizza secondo una classificazione di tipo gerarchico dalla quale \u00e8 possibile definire la tipologia forestale in base a caratteristiche:  - Fisionomiche (presenza di gruppi di specie dominanti);  - Strutturali (distribuzione spaziale della vegetazione);  - di Copertura (% di superficie coperta dalla proiezione delle chiome sul terreno da parte delle specie principale e secondaria);  - di Gestione (forma di governo e trattamento);  - di Composizione del soprassuolo (individuazione della specie prevalente e, qualora presente, di quella secondaria)", "num_resources": 3, "num_tags": 3, "organization": {"id": "c25963f5-2065-4819-9072-35a021ed3d11", "name": "regione-emilia-romagna", "title": "Regione Emilia Romagna", "type": "organization", "description": "", "image_url": "", "created": "2024-03-08T21:35:32.089864", "is_organization": true, "approval_status": "approved", "state": "active"}, "owner_org": "c25963f5-2065-4819-9072-35a021ed3d11", "private": false, "state": "active", "title": "Carte forestali CMBO - Carta forestale 2003 e successivi aggiornamenti. Estensione: Provincia di Bologna", "type": "dataset", "url": "", "version": "", "extras": [{"key": "contact_email", "value": "cm.bo@cert.cittametropolitana.bo.it"}, {"key": "contact_name", "value": "citta-metropolitana-di-bologna"}, {"key": "contact_uri", "value": "https://dati.emilia-romagna.it/organization/3b27a1ce-ca65-46c8-9d4a-53b5987b6713"}, {"key": "guid", "value": "https://dati.emilia-romagna.it/dataset/408c9a15-8101-41a5-99a0-8995f038b11f"}, {"key": "landingpage", "value": "https://dati.emilia-romagna.it/dataset/cmbo_2022-02-15t141454"}, {"key": "provenance", "value": "Dataset pubblicato da Citt\u00e0 Metropolitana di Bologna nel catalogo CKAN Regione Emilia Romagna (https://dati.emilia-romagna.it//#), acquisito da Dati Gov IT tramite harvesting."}, {"key": "source_catalog_description", "value": "Portale OpenData regionale"}, {"key": "source_catalog_homepage", "value": "https://dati.emilia-romagna.it//#"}, {"key": "source_catalog_langu