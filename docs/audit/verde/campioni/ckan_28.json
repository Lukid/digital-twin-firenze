7", "name": "eu", "state": "active", "vocabulary_id": null}, {"display_name": "foreste", "id": "435d5940-f55f-4c22-9b14-5847b2a11f71", "name": "foreste", "state": "active", "vocabulary_id": null}, {"display_name": "open-data", "id": "4705865b-6371-45f0-b888-e29a6e16e855", "name": "open-data", "state": "active", "vocabulary_id": null}], "relationships_as_subject": [], "relationships_as_object": [], "dataset_is_local": false, "holder_name": "Regione Emilia Romagna", "holder_identifier": "r_emiro", "issued": "2022-02-25T12:32:33.954408"}, {"author": null, "author_email": null, "creator_user_id": "e514c9c4-6d64-45d6-ae28-c70bd3592d59", "id": "ee2d3e53-4ec5-4a9d-b0a0-2b523fa54acf", "isopen": false, "license_id": "Creative Commons Attribuzione 4.0 Internazionale (CC BY 4.0)", "license_title": "Creative Commons Attribuzione 4.0 Internazionale (CC BY 4.0)", "maintainer": null, "maintainer_email": null, "metadata_created": "2026-05-23T23:19:45.848274", "metadata_modified": "2026-09-19T12:32:26.875063", "name": "copernicus-forest-italia-dataset", "notes": "Gli High Resolution Layer - Forest sono datasets prodotti nell\u2019ambito della componente Pan-Europea dei servizi di monitoraggio della copertura e uso del suolo del programma Copernicus (CLMS). Essi sono costituiti dalla serie temporale 2012 e 2015 e sono stati prodotti utilizzando dati satellitari multitemporali e multispettrali ad alta risoluzione, in particolare Sentinel-2A (ESA) e Landsat 8 (USGS). I datasets del Forest sono costituiti da due diversi prodotti: Dominant Leaf Type (DLT) e Tree Cover Density (TCD) che rappresentano entrambi lo \u2018status layer\u2019. Il prodotto Tree Cover Density viene definito come \u2018proiezione verticale delle chiome degli alberi sulla superficie terrestre\u2019 e fornisce informazioni sulla quantit\u00e0 di copertura della chioma all\u2019interno del pixel espressa in valori percentuali da 0 a 100. Il prodotto Dominant Leaf Type fornisce l\u2019informazione sul tipo di vegetazione dominante, latifoglia o conifera, e ricopre la stessa estensione spaziale del Tree Cover Density. Entrambi i prodotti hanno una risoluzione spaziale di 20 metri, non hanno unit\u00e0 minima cartografabile (MMU) ma hanno un\u2019ampiezza minima (MMW) di 20 metri e sono basati sul pixel. Entrambi sono disponibili anche nella versione aggregata a 100 metri di risoluzione. La frequenza di aggiornamento del dato \u00e8 di 3 anni. La produzione degli HRL Forest \u00e8 stata coordinata dall\u2019Agenzia Europea dell\u2019Ambiente nell\u2019ambito del programma europeo Copernicus coinvolgendo i National Reference Centre on Land Cover della rete Eionet (per l\u2019Italia, rappresentato da ISPRA). Ulteriori informazioni si possono trovare all\u2019indirizzo https://land.copernicus.eu/pan-european/high-resolution-layers/forests", "num_resources": 1, "num_tags": 6, "organization": {"id": "9eeff220-80c1-4da9-a7ef-fd2af6e2fb78", "name": "geodati-gov-it-rndt", "title": "GeoDati - RNDT", "type": "organization", "description": "", "image_url": "", "created": "2024-03-08T18:47:26.076098", "is_organization": true, "approval_status": "approved", "state": "active"}, "owner_org": "9eeff220-80c1-4da9-a7ef-fd2af6e2fb78", "private": false, "state": "active", "title": "Copernicus Forest Italia - Dataset", "type": "dataset", "url": "", "version": null, "extras": [{"key": "contact_email", "value": "urp@isprambiente.it"}, {"key": "contact_name", "value": "Istituto Superiore per la Protezione e la Ricerca Ambientale"}, {"key": "contact_uri", "value": "https://geodati.gov.it/resource/pointOfContact/ispra_rm:Meta_Geo_CS001_DT-1"}, {"key": "guid", "value": "https://geodati.gov.it/resource/id/ispra_rm:Meta_Geo_CS001_DT"}, {"key": "landingpage", "value": "http://sgi2.isprambiente.it/arcgis/services/copertura_del_suolo/FOREST/MapServer/WMSServer?request=GetCapabilities&service=WMS"}, {"key": "publisher_uri", "value": "https://geodati.gov.it/resource/administration/ispra_rm:Meta_Geo_CS001_DT/publisher"}, {"key": "source_catalog_description", "value": "Il servizio di ricerca del RNDT fornisce l'accesso ai metadati su dati e servizi territoriali delle Pubbliche Amministrazioni italiane. Esso \u00e8 conforme alle specifiche CSW (ISO Application Profile) di OGC e alle linee guida INSPIRE sui servizi di ricerca"}, {"key": "source_catalog_homepage", "value": "https://geodati.gov.it/"}, {"key": "source_catalog_language", "value": "http://publications.europa.eu/resource/authority/language/ITA"}, {"key": "source_catalog_modified", "value": "2026-09-18"}, {"key": "source_catalog_publisher", "value": "{\"uri\": \"https://indicepa.gov.it/ricerca/n-dettaglioamministrazione.php?cod_amm=agid\", \"name\": \"Agenzia per l'Italia Digitale\", \"email\": \"\", \"url\": \"\", \"type\": \"\"}"}, {"key": "source_catalog_title", "value": "RNDT - Repertorio Nazionale dei Dati Territoriali - Servizio di ricerca"}, {"key": "spatial", "value": "{\"type\": \"Polygon\", \"coordinates\": [[[18.1001, 48.8717], [6.601, 48.8717], [6.601, 35.3421], [18.1001, 35.3421], [18.1001, 48.8717]]]}"}, {"key": "spatial_uri", "value": "https://geodati.gov.it/resource/spatial/ispra_rm:Meta_Geo_CS001_DT"}, {"key": "uri", "value": "https://geodati.gov.it/resource/id/ispra_rm:Meta_Geo_CS001_DT"}, {"key": "theme", "value": "[\"ENVI\", \"ECON\"]"}, {"key": "harvest_object_id", "value": "36ae2edc-4698-49ee-9716-62a2514fd9b6"}, {"key": "harvest_source_id", "value": "6d9e8d13-fa0a-4bb4-b209-023cf3f58559"}, {"key": "harvest_source_title", "value": "GeoDati-RNDT"}, {"key": "identifier", "value": "ispra_rm:Geo_CS001DT"}, {"key": "access_rights", "value": "http://publications.europa.eu/resource/authority/access-right/PUBLIC"}, {"key": "alternate_identifier", "value": "[]"}, {"key": "themes_aggregate", "value": "[{\"theme\": \"ENVI\", \"subthemes\": []}, {\"theme\": \"ECON\", \"subthemes\": []}]"}, {"key": "publisher_name", "value": "Istituto Superiore per la Protezione e la Ricerca Ambientale"}, {"key": "publisher_id