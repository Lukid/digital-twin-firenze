{"help": "https://dati.toscana.it/api/3/action/help_show?name=package_show", "success": true, "result": {"access_rights": "http://publications.europa.eu/resource/authority/access-right/PUBLIC", "alternate_identifier": "[]", "author": null, "author_email": null, "conforms_to": "[{\"identifier\": \"http://dati.gov.it/onto/dcatapit#\", \"title\": {\"it\": \"\"}, \"description\": {\"it\": \"\"}, \"referenceDocumentation\": []}]", "creator": "[]", "creator_user_id": "b62c8839-3939-4e00-8e17-0d4846e846b1", "frequency": "IRREG", "holder_identifier": "p_PI", "holder_name": "Provincia di Pisa", "id": "2a4323d8-7ab5-4338-986a-0c23afb6981b", "identifier": "p_PI:edifici_scolastici:1", "isopen": false, "language": "ITA", "license_id": "Creative Commons Attribuzione 4.0 Internazionale (CC BY 4.0)", "license_title": "Creative Commons Attribuzione 4.0 Internazionale (CC BY 4.0)", "maintainer": null, "maintainer_email": null, "metadata_created": "2025-01-07T14:18:04.689110", "metadata_modified": "2026-09-30T23:15:25.180546", "modified": "25-07-2017", "name": "edifici-scolastici", "notes": "Database edifici scolastici ", "num_resources": 3, "num_tags": 1, "organization": {"id": "914c137c-46c3-4a5e-80b4-d2ea984f3163", "name": "provincia-di-pisa", "title": "Provincia di Pisa", "type": "organization", "description": "La provincia di Pisa \u00e8 una provincia italiana della Toscana. \u00c8 la seconda provincia toscana per numero di abitanti, e per quanto riguarda la superficie, con i suoi 2 444 km quadri \u00e8 al quinto posto tra le dieci province toscane.", "image_url": "2017-03-30-075935.095148ProvinciadiPisa-Stemma.png", "created": "2017-03-30T09:59:35.126374", "is_organization": true, "approval_status": "approved", "state": "active"}, "owner_org": "914c137c-46c3-4a5e-80b4-d2ea984f3163", "private": false, "publisher_identifier": "p_PI", "publisher_name": "Provincia di Pisa", "state": "active", "themes_aggregate": "[{\"theme\": \"EDUC\", \"subthemes\": []}]", "title": "Edifici Scolastici", "type": "dataset", "url": "", "version": "", "extras": [{"key": "contact_email", "value": "studiestatistica@provincia.pisa.it"}, {"key": "contact_name", "value": "Provincia di Pisa"}, {"key": "guid", "value": "p_PI:edifici_scolastici:1"}, {"key": "landingpage", "value": "https://opendata.provincia.pisa.it/datasets/edifici_scolastici"}, {"key": "source_catalog_description", "value": "Catalogo dei dati aperti (Open Data) - Provincia di Pisa"}, {"key": "source_catalog_homepage", "value": "https://opendata.provincia.pisa.it/index.php"}, {"key": "source_catalog_language", "value": "http://publications.europa.eu/resource/authority/language/ITA"}, {"key": "source_catalog_modified", "value": "2026-10-01"}, {"key": "source_catalog_publisher", "value": "{\"uri\": \"\", \"name\": \"Provincia di Pisa\", \"email\": \"\", \"url\": \"\", \"type\": \"\"}"}, {"key": "source_catalog_title", "value": "Catalogo Opendata - Provincia di Pisa"}, {"key": "uri", "value": ""}, {"key": "theme", "value": "[\"EDUC\"]"}, {"key": "harvest_object_id", "value": "ecaf1f69-97c8-4217-8ce3-44b089bb19d5"}, {"key": "harvest_source_id", "value": "52e910b4-998b-4c79-a8ca-b4f9a8dc6095"}, {"key": "harvest_source_title", "value": "Harvester della Provincia di Pisa"}], "groups": [{"description": "Un estratto dei dati sull'immenso patrimonio culturale regionale.\r\n\r\nLa cultura sta alla Toscana come i giacimenti di petrolio agli Emirati. Oltre 500 musei, mille biblioteche, circa 250 teatri funzionanti, 48 grandi istituzioni culturali, 8 tra universit\u00e0 e scuole di alta formazione, una miriade di associazioni. E pi\u00f9 di 20 mila beni culturali censiti, cio\u00e8 una delle quote pi\u00f9 alte nell'enorme patrimonio culturale conservato in Italia. Festival, editoria e media; una terra dove \u00e8 piacevole girare storie per il grande schermo e che tratta con cura la Memoria, per ricordare le radici di una civilt\u00e0 politica alla base della democrazia.\r\n\r\nUn eccezionale patrimonio di fede e cultura. Grandi istituzioni culturali che il passato ci ha tramandato. Una Regione che custodisce il passato, ma si misura con il contemporaneo.\r\n\r\nOgni anno questa terra attira milioni di visitatori, in una miscela di turismo e cultura destinata a farla crescere, anche economicamente.", "display_name": "Cultura", "id": "c9d4c606-4431-43a5-bb46-28503421b6f4", "image_display_url": "", "name": "cultura", "title": "Cultura"}], "resources": [{"access_url": "https://maps.provincia.pisa.it/metarepo2/api/datasets/edifici_scolastici/download", "cache_last_updated": null, "cache_url": null, "created": "2025-01-07T14:18:04.694412", "datastore_active": false, "datastore_contains_all_records_of_source_file": false, "description": "Questa \u00e8 la distribuzione completa in formato ZIP del dataset Edifici Scolastici  - Provincia di Pisa", "distribution_format": "ZIP", "distribution_ref": "https://maps.provincia.pisa.it/metarepo2/api/datasets/edifici_scolastici/download", "download_url": "https://maps.provincia.pisa.it/metarepo2/api/datasets/edifici_scolastici/download", "format": "ZIP", "hash": "", "id": "0a2fa98c-0700-4ab7-98d8-8762e36a22d9", "last_modified": null, "license": "https://creativecommons.org/licenses/by/4.0/legalcode", "license_id": "Creative Commons Attribuzione 4.0 Internazionale (CC BY 4.0)", "license_type": "https://w3id.org/italia/controlled-vocabulary/licences/A21_CCBY40", "metadata_modified": "2026-01-29T00:24:56.107351", "mimetype": "https://www.iana.org/assignments/media-types/application/zip", "mimetype_inner": null, "name": "Distribuzione ZIP di Edifici Scolastici ", "package_id": "2a4323d8-7ab5-4338-986a-0c23afb6981b", "position": 0, "resource_type": null, "rights": "http://publications.europa.eu/resource/authority/access-right/PUBLIC", "size": null, "state": "active", "uri": "https://maps.provincia.pisa.it/metarepo2/api/datasets/edifici_scolastici/download", "url": "https://maps.provincia.pisa.it/metarepo2/api/datasets/edifici_scolastici/download", "