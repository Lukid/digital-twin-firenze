{"help": "https://dati.toscana.it/api/3/action/help_show?name=package_show", "success": true, "result": {"author": "Comune di Firenze", "author_email": "opendata@comune.fi.it", "creator": "[{\"creator_identifier\": \"c_d612\", \"creator_name\": {\"en\": \"Comune di Firenze\", \"it\": \"Comune di Firenze\"}}]", "creator_user_id": "b62c8839-3939-4e00-8e17-0d4846e846b1", "frequency": "AS_NEEDED", "geographical_geonames_url": "https://www.geonames.org/6542285", "geographical_name": "ITA_FLR", "holder_identifier": "c_d612", "holder_name": "Comune di Firenze", "id": "life_escapos_mobile_measurements", "identifier": "c_d612:D.7840", "isopen": false, "issued": "12-02-2026", "language": "ITA", "license_id": "cc-by-nc-4.0", "license_title": "cc-by-nc-4.0", "maintainer": "Comune di Firenze", "maintainer_email": "opendata@comune.fi.it", "metadata_created": "2026-02-13T06:03:11.703076", "metadata_modified": "2026-02-13T06:03:11.703081", "modified": "12-02-2026", "name": "life_escapos_mobile_measurements", "notes": "Il dataset raccoglie i parametri strutturali e ambientali delle alberature pubbliche nell'area di Firenze Nova. I dati includono per ogni albero: la specie, le dimensioni (per esempio il diametro a petto d\u2019uomo \u2014 a circa 130cm dal suolo \u2014, l'altezza complessiva e l'ampiezza della chioma) e le stime della capacit\u00e0 di assorbimento degli inquinanti atmosferici. Il campione \u00e8 ristretto agli alberi nell\u2019area di studio presenti nel database aggiornato dalla Direzione Ambiente del Comune di Firenze.", "num_resources": 3, "num_tags": 8, "organization": {"id": "881795ff-b47f-4c85-923c-b67b2d86fd8d", "name": "comune-di-firenze", "title": "Comune di Firenze", "type": "organization", "description": "Firenze (in epoca medievale e nel linguaggio poetico anche Fiorenza) \u00e8 un comune italiano, capoluogo dell'omonima citt\u00e0 metropolitana e della regione Toscana; primo comune della regione per popolazione e centro dell'area metropolitana di Firenze-Prato-Pistoia.", "image_url": "2016-10-12-135352.489839comune-firenze.png", "created": "2016-10-12T15:53:52.505338", "is_organization": true, "approval_status": "approved", "state": "active"}, "owner_org": "881795ff-b47f-4c85-923c-b67b2d86fd8d", "private": false, "publisher_identifier": "c_d612", "publisher_name": "Comune di Firenze", "state": "active", "themes_aggregate": "[{\"theme\": \"ENVI\", \"subthemes\": []}]", "title": "Life Escapos - Alberature pubbliche", "type": "dataset", "url": "https://data.comune.fi.it/datastore/download.php?id=7840&type=1", "version": "1", "extras": [{"key": "bbox-east-long", "value": "11.348"}, {"key": "bbox-north-lat", "value": "43.84"}, {"key": "bbox-south-lat", "value": "43.718"}, {"key": "bbox-west-long", "value": "11.145"}, {"key": "created", "value": "12/02/2026"}, {"key": "encoding", "value": "utf8"}, {"key": "frequency-of-update-url", "value": "http://publications.europa.eu/resource/authority/frequency/AS_NEEDED"}, {"key": "harvest_url", "value": "https://data.comune.fi.it/datastore/dataset/life_escapos_mobile_measurements"}, {"key": "publisher", "value": "[{\"publisher_identifier\":\"c_d612\",\"publisher_name\":{\"en\":\"Comune di Firenze\",\"it\":\"Comune di Firenze\"}}]"}, {"key": "spatial", "value": "{\"type\":\"Polygon\",\"coordinates\":[[[11.145,43.718],[11.348,43.718],[11.348,43.84],[11.145,43.84],[11.145,43.718]]]}"}, {"key": "spatial-reference-system", "value": "ROMA40/OVEST"}, {"key": "spatial_harvester", "value": "true"}, {"key": "theme", "value": "[\"ENVI\"]"}, {"key": "harvest_object_id", "value": "26b723bd-28ab-4d9c-9c92-cfe5bed7152b"}, {"key": "harvest_source_id", "value": "6b5fa52a-0674-4548-a403-5bae105adf47"}, {"key": "harvest_source_title", "value": "comune firenze"}], "groups": [{"description": "", "display_name": "Dati Territoriali", "id": "0ee7b0af-9da7-48bf-b44a-0b57eaed1b92", "image_display_url": "", "name": "dati_territoriali", "title": "Dati Territoriali"}, {"description": "", "display_name": "geod